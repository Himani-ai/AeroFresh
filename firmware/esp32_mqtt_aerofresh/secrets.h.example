#pragma once
// Copy this file to secrets.h and replace every placeholder.
// Never commit secrets.h to GitHub.
#define WIFI_SSID "YOUR_WIFI_NAME"
#define WIFI_PASSWORD "YOUR_WIFI_PASSWORD"

// HiveMQ Cloud: use the cluster hostname only (no scheme and no port).
#define MQTT_HOST "YOUR_CLUSTER.s1.eu.hivemq.cloud"
#define MQTT_TLS_PORT 8883
#define MQTT_USERNAME "YOUR_DEVICE_USERNAME"
#define MQTT_PASSWORD "YOUR_DEVICE_PASSWORD"

// Paste the PEM root CA certificate that validates your broker's TLS certificate.
// Obtain it from your broker/provider's official connection guide.
// Keep the BEGIN/END CERTIFICATE lines and the trailing newline.
static const char MQTT_ROOT_CA[] PROGMEM = R"EOF(
-----BEGIN CERTIFICATE-----
PASTE_THE_BROKER_ROOT_CA_CERTIFICATE_HERE
-----END CERTIFICATE-----
)EOF";
